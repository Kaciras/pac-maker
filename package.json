{
	"name": "pac-maker",
	"version": "5.0.0",
	"description": "Proxy Auto-Configuration (PAC) file generator & loader, support proxy Node's `fetch` with PAC",
	"author": "Kaciras <contact@kaciras.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Kaciras/pac-maker.git"
	},
	"keywords": [
		"pac",
		"proxy",
		"gfw",
		"fetch",
		"undici"
	],
	"engines": {
		"node": ">=26"
	},
	"type": "module",
	"files": [
		"lib/**/*.{js,d.ts}",
		"list",
		"template"
	],
	"bin": {
		"pac-maker": "lib/cli.js"
	},
	"types": "lib/index.d.ts",
	"main": "lib/index.js",
	"scripts": {
		"lint": "eslint --fix",
		"test": "jest",
		"test:mutation": "stryker run",
		"compile": "tsc"
	},
	"dependencies": {
		"@kaciras/deasync": "^1.1.0",
		"@kaciras/utilities": "^1.1.0",
		"cli-progress": "^3.12.0",
		"esbench": "^0.8.1",
		"ini": "^7.0.0",
		"undici": "^8.10.2",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@jest/globals": "^30.5.1",
		"@kaciras/eslint-config-core": "^3.4.2",
		"@kaciras/eslint-config-jest": "^3.4.2",
		"@kaciras/eslint-config-typescript": "^3.4.2",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/jest-runner": "^10.0.0",
		"@swc/core": "1.16.2",
		"@swc/jest": "^0.2.39",
		"@types/cli-progress": "^3.11.6",
		"@types/ini": "^4.1.1",
		"@types/yargs": "^17.0.35",
		"eslint": "^10.10.0",
		"jest": "^30.5.1",
		"mockttp": "^4.6.2",
		"typescript": "^7.0.2",
		"wait-for-expect": "^4.0.0"
	}
}
